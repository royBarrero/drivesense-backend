DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/drivesense_db

# JWT (genera un secreto con: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_ALGORITMO=HS256
JWT_EXPIRACION_MINUTOS=10080

# CORS: orígenes permitidos separados por comas (panel web)
CORS_ORIGENES=http://localhost:5173

# Temporal (modo pruebas): correo de la cuenta admin compartida que ve los viajes de
# todos los conductores. Vacío = endpoints /pruebas desactivados. Quitar antes de producción
PRUEBAS_CORREO=

# IA de las recomendaciones del viaje (Claude). Vacía = se usan las plantillas fijas.
# La clave se crea en https://platform.claude.com. No subirla a Git
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-5-5
IA_TIMEOUT_S=7

# Rutas y búsqueda de destinos (HU-30). Solo las usa el backend: nada de esto va a la app.
# NAVEGACION_PROVEEDOR: osrm (OSRM + Nominatim, sin clave; por defecto), ors (OpenRouteService,
# con ORS_API_KEY) o desactivada (los endpoints responden 503 con un mensaje)
NAVEGACION_PROVEEDOR=osrm
NAVEGACION_TIMEOUT_S=8
# Servidores públicos de OpenStreetMap (uso razonable, sin garantía); o uno propio
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Solo con NAVEGACION_PROVEEDOR=ors. La clave se crea en https://openrouteservice.org/dev. No subirla a Git
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org
