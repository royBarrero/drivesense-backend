# Copiar a deploy/.env y completar. No subir el .env a Git.

# Dominio público de la instancia, sin https://. Con sslip.io: la IP elástica con guiones,
# p. ej. 3-85-120-14.sslip.io. Para probar en local: localhost
DOMINIO=3-85-120-14.sslip.io

# PostgreSQL (contenedor db). La contraseña va dentro de la URL de conexión:
# usar solo letras y números (genera una con: python -c "import secrets; print(secrets.token_hex(24))")
POSTGRES_USER=drivesense
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=drivesense_db

# JWT (genera un secreto con: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Temporal (modo pruebas): correo de la cuenta admin compartida. Vacío = desactivado
PRUEBAS_CORREO=
